enum UserRole {
  ADMIN
  USER
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
}

enum ProductType {
  RAW_BEAD
  ORNAMENT
}

enum PaymentMethod {
  ESEWA
  KHALTI
  STRIPE
  COD
}

model PaymentSettings {
  id            Int      @id @default(autoincrement())
  esewaEnabled  Boolean  @default(true)
  khaltiEnabled Boolean  @default(true)
  stripeEnabled Boolean  @default(true)
  codEnabled    Boolean  @default(true)
  updatedAt     DateTime @default(now())
}

model StoreSettings {
  id                              Int      @id @default(autoincrement())
  storeName                       String
  customerSupportEmail            String
  standardConsecrationFee         Int
  freeShippingThreshold           Int
  primaryTempleConsecrationOrigin String
  updatedAt                       DateTime @default(now())
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  role               UserRole? @default(USER)
  firstName          String
  lastName           String
  hashedRefreshToken String?
  isEmailVerified    Boolean?
  password           String
  phoneNumber        String
  cart               Cart?
  otps               Otp[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now())
}

model Otp {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  type       OtpType
  expiresAt  DateTime  @default(now())
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@unique([userId, type, createdAt])
}

model Category {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  slug        String      @unique
  type        ProductType
  description String?
  products    Product[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  type        ProductType
  description String?
  price       Int
  stock       Int         @default(0)
  mukhi       Int?
  imageUrl    String?
  isActive    Boolean     @default(true)
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  cartItems   CartItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique // unique → one cart per user (one-to-one)
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([cartId, productId]) // same product appears once per cart; bump quantity instead
}
