enum UserRole {
  ADMIN
  USER
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
}

enum PaymentMethod {
  ESEWA
  KHALTI
  STRIPE
  COD
}

model PaymentSettings {
  id            Int      @id @default(autoincrement())
  esewaEnabled  Boolean  @default(true)
  khaltiEnabled Boolean  @default(true)
  stripeEnabled Boolean  @default(true)
  codEnabled    Boolean  @default(true)
  updatedAt     DateTime @default(now())
}

model StoreSettings {
  id                              Int      @id @default(autoincrement())
  storeName                       String
  customerSupportEmail            String
  standardConsecrationFee         Int
  freeShippingThreshold           Int
  primaryTempleConsecrationOrigin String
  updatedAt                       DateTime @default(now())
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  role               UserRole? @default(USER)
  firstName          String
  lastName           String
  hashedRefreshToken String?
  isEmailVerified    Boolean?  @default(false)
  password           String?
  phoneNumber        String?
  accounts           Account[]
  otps               Otp[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now())
}

model Account {
  id                Int    @id @default(autoincrement())
  userId            Int
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Otp {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  type       OtpType
  expiresAt  DateTime  @default(now())
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@unique([userId, type, createdAt])
}

enum ProductType {
  INDIVIDUAL_RUDRAKSHA
  RUDRAKSHA_MALA
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String
  type        ProductType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())

  productVariants           ProductVariant[]
  productImages             ProductImage[]
  individualRudrakshaDetail IndividualRudrakshaDetail?
  rudrakshaMalaDetail       RudrakshaMalaDetail?

  @@index([type])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  color       String?
  originId    Int?
  origin      RudrakshaOrigin? @relation(fields: [originId], references: [id])
  weightGrams Float?

  stock     Int      @default(0)
  price     Int      @default(0)
  sku       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  individualVariantAttrs IndividualVariantAttrs?
  malaVariantAttrs       MalaVariantAttrs?
  variantImages          VariantImage[]

  @@index([productId])
  @@index([originId])
}

model IndividualVariantAttrs {
  id        Int            @id @default(autoincrement())
  variantId Int            @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  size      Int
}

model MalaVariantAttrs {
  id        Int            @id @default(autoincrement())
  variantId Int            @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  beadCount Int?
  material  String?
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([productId])
}

model VariantImage {
  id        Int            @id @default(autoincrement())
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now())

  @@index([variantId])
}

model RudrakshaOrigin {
  id        Int      @id @default(autoincrement())
  name      String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  productVariants ProductVariant[]

  @@unique([name, country])
}

model IndividualRudrakshaDetail {
  id        Int     @id @default(autoincrement())
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  mukhi     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model RudrakshaMalaDetail {
  id        Int      @id @default(autoincrement())
  productId Int      @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mukhi     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}
